# Copy to .env and fill in. Never commit .env.

# --- Lane A: rendering (Daytona) ---
DAYTONA_API_KEY=
DAYTONA_TARGET=us
# Seconds. Daytona's default exec timeout is 10s, which is too tight for a cold sandbox.
DAYTONA_EXEC_TIMEOUT=60

# --- Lane A: publishing (One -> Gmail) ---
# Resolved at the phase-1 gate; full reasoning in contracts/one_action.md.
# Google Drive was ruled out: One exposes only Drive's metadata endpoint, which
# creates a named file with no contents.
# ONE_SECRET is only needed for headless use; `one login` stores its own creds.
ONE_SECRET=
ONE_PLATFORM=gmail
ONE_ACTION_ID=conn_mod_def::GGXAjWkZO8U::uMc1LQIHTTKzeMm3rLL5gQ
# Yours will differ — run `one list` after `one add gmail`.
ONE_CONNECTION_KEY=
# Where a published curriculum is sent.
ONE_RECIPIENT=
# Gmail nests the id two levels deep and returns no URL, so the link is built.
ONE_RESULT_ID_PATH=response.email.messageId
ONE_RESULT_URL_TEMPLATE=https://mail.google.com/mail/u/0/#all/{id}

# --- Lane B: research and agents ---
YOU_API_KEY=
OPENAI_API_KEY=
CURRICULUMAI_MODEL=

# --- Degradation switches (see "Degradation and cuts" in the build plan) ---
# 1 = render locally instead of in a Daytona sandbox
CURRICULUMAI_RENDER_LOCAL=0
# 1 = write the artifact to ./artifacts/ instead of publishing through One
CURRICULUMAI_PUBLISH_LOCAL=0
