# Copy to .env and fill in. Never commit .env.

# --- Lane A: rendering (Daytona) ---
DAYTONA_API_KEY=
DAYTONA_TARGET=us
# Seconds. Daytona's default exec timeout is 10s, which is too tight for a cold sandbox.
DAYTONA_EXEC_TIMEOUT=60

# --- Lane A: publishing (One) ---
# Fill these in during the phase-1 readiness gate, from:
#   one actions search <platform> "<query>"
#   one actions knowledge <platform> <actionId>
# Record the non-secret values in contracts/one_action.md as well.
ONE_SECRET=
ONE_PLATFORM=
ONE_ACTION_ID=
ONE_CONNECTION_KEY=
# Dotted paths into the One response where the receipt fields live.
# Pin these once you have seen one real response.
ONE_RESULT_ID_PATH=id
ONE_RESULT_URL_PATH=webViewLink

# --- Lane B: research and agents ---
YOU_API_KEY=
OPENAI_API_KEY=
CURRICULUMAI_MODEL=

# --- Degradation switches (see "Degradation and cuts" in the build plan) ---
# 1 = render locally instead of in a Daytona sandbox
CURRICULUMAI_RENDER_LOCAL=0
# 1 = write the artifact to ./artifacts/ instead of publishing through One
CURRICULUMAI_PUBLISH_LOCAL=0
